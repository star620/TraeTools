<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TraeTools.Views.PromptWindow" Width="460"
        Background="White"
        FontFamily="Microsoft YaHei UI,Segoe UI">
    <Border Background="White" Padding="22">
        <StackPanel Spacing="18">
            <TextBlock x:Name="MessageText" FontSize="13" Foreground="#FF0F172A" TextWrapping="Wrap" LineHeight="21" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="CancelButton" MinWidth="100" Height="34" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" MinWidth="100" Height="34" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="btn-primary" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
