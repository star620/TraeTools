<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TraeTools.ViewModels"
        xmlns:views="using:TraeTools.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="TraeTools.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="TraeTools"
        Width="1100" Height="720"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBgBrush}"
        FontFamily="Inter,Microsoft YaHei UI,Segoe UI">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- 桌面端外壳（仅 Windows）：
         主界面本体是 MainView（UserControl，Android 单视图平台复用同一份），
         本窗口只负责桌面专有的托盘、关闭即最小化等行为，避免两平台各维护一套界面。 -->
    <views:MainView />
</Window>
